# ── Envoi des commandes sur WhatsApp (CallMeBot) ─────────────────────────
# Numéro WhatsApp de la boulangère, format international, et sa clé CallMeBot.
CALLMEBOT_PHONE=+336XXXXXXXX
CALLMEBOT_APIKEY=XXXXXX

# Facultatif : un second numéro qui reçoit une copie (il a sa propre clé).
CALLMEBOT_PHONE_BACKUP=
CALLMEBOT_APIKEY_BACKUP=

# Mot de passe de la route de test : /api/test-whatsapp?secret=...
TEST_SECRET=

# Adresse publique du site (pour le sitemap, les partages, le JSON-LD).
NEXT_PUBLIC_SITE_URL=https://aubonpain-sete.fr
