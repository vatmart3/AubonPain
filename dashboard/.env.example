# --- Obligatoire -------------------------------------------------------------
# Clé SECRÈTE SumUp (commence par sup_sk_). SumUp → Paramètres → Développeurs → Clés API.
# Lue uniquement côté serveur, jamais envoyée au navigateur.
SUMUP_API_KEY=sup_sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Code commerçant SumUp (ex. MC4X7ZPQ). Si absent, il est lu via GET /v0.1/me.
SUMUP_MERCHANT_CODE=

# Mot de passe de la page de connexion.
DASHBOARD_PASSWORD=

# --- Facultatif ---------------------------------------------------------------
# Clé de signature des sessions. Par défaut dérivée du mot de passe
# (changer le mot de passe déconnecte alors tous les téléphones).
# SESSION_SECRET=

# Fuseau de la boutique et plage horaire des courbes / heatmap.
# DASHBOARD_TIMEZONE=Europe/Paris
# OPEN_HOUR=6
# CLOSE_HOUR=20
